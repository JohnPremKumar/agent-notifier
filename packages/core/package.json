{
  "name": "@agent-notifier/core",
  "version": "0.1.2",
  "private": true,
  "description": "Internal core for agent-notifier (bundled into the published CLI; not a separately published package).",
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "gemini",
    "opencode",
    "cli",
    "notifier",
    "macos",
    "windows",
    "hooks",
    "agents"
  ],
  "author": "Johnpremkumar Srinivasan <johnpk305@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/JohnPremKumar/agent-notifier#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohnPremKumar/agent-notifier.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/JohnPremKumar/agent-notifier/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "node-notifier": "^10.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node-notifier": "^8.0.5"
  }
}
