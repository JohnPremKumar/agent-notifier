    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "node-notifier": "^10.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node-notifier": "^8.0.5"
  }
